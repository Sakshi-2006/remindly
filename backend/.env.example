# Safe defaults: simulate every delivery and never send mail.
DRY_RUN=true
DATABASE_PATH=data/automation.db

# Only configure these for a mailbox you control, then explicitly set DRY_RUN=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=Nudge Demo
